# Copy to `.env` for local development, and add the same key under
# Netlify > Site configuration > Environment variables for production.
#
# Endpoint that receives a POST when someone downloads the CV.
# Payload: { timestamp, userAgent, referrer }
# Works with a Make.com / Zapier webhook, or an AWS Lambda function URL.
#
# While this is unset (or left as the placeholder), the notification request is
# skipped and the CV still downloads normally.
VITE_CV_WEBHOOK_URL=https://your-webhook-url.com/cv-download
